<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F4"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="24dp"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <!-- LOGO -->
        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginBottom="18dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_teal"
                android:src="@drawable/ic_logo_wil"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:contentDescription="Logo WIL"/>

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|end"
                android:src="@drawable/ic_badge_check"
                android:contentDescription="Verificado"/>
        </FrameLayout>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Domicilios WIL"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1E1B17"
            android:letterSpacing="-0.02"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal de acceso para domiciliarios"
            android:textSize="13sp"
            android:textColor="#6F7976"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"/>

        <!-- BADGE ALIANZA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_badge_alianza"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN ALIANZA CON"
                android:textSize="9sp"
                android:textColor="#6F7976"
                android:letterSpacing="0.12"
                android:layout_marginBottom="4dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Droguería Farma Expertos"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00B5B0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • "
                    android:textSize="11sp"
                    android:textColor="#9AA5A4"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Droguería Central"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#00B5B0"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Copacabana, Antioquia"
                android:textSize="10sp"
                android:textColor="#9AA5A4"
                android:layout_marginTop="3dp"/>
        </LinearLayout>

        <!-- CARD DE LOGIN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Header card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="22dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_teal"
                        android:layout_marginEnd="12dp">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_moto"
                            android:contentDescription="Domiciliario"/>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ingreso Domiciliario"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1E1B17"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Accede con tu ID y clave asignada"
                            android:textSize="12sp"
                            android:textColor="#6F7976"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Label ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID DOMICILIARIO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#3F4946"
                    android:letterSpacing="0.10"
                    android:layout_marginBottom="6dp"/>

                <!-- Campo ID -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_field"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_badge"
                        android:layout_marginEnd="10dp"
                        android:alpha="0.45"
                        android:contentDescription="ID"/>

                    <EditText
                        android:id="@+id/etIdWil"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="Ej: WIL-042"
                        android:textColorHint="#9AA5A4"
                        android:textColor="#1E1B17"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:textAllCaps="true"
                        android:background="@null"
                        android:imeOptions="actionNext"
                        android:maxLines="1"/>
                </LinearLayout>

                <!-- Label CLAVE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CLAVE DE ACCESO"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#3F4946"
                        android:letterSpacing="0.10"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Asignada por WIL"
                        android:textSize="10sp"
                        android:textColor="#9AA5A4"/>
                </LinearLayout>

                <!-- Campo CLAVE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_field"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:layout_marginBottom="22dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lock"
                        android:layout_marginEnd="10dp"
                        android:alpha="0.45"
                        android:contentDescription="Clave"/>

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:hint="••••••••"
                        android:textColorHint="#9AA5A4"
                        android:textColor="#1E1B17"
                        android:textSize="16sp"
                        android:inputType="textPassword"
                        android:background="@null"
                        android:imeOptions="actionDone"
                        android:maxLines="1"/>

                    <ImageView
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_eye"
                        android:alpha="0.45"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="Mostrar clave"/>
                </LinearLayout>

                <!-- ProgressBar -->
                <ProgressBar
                    android:id="@+id/progressLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="#00B5B0"
                    android:layout_marginBottom="8dp"/>

                <!-- Error -->
                <TextView
                    android:id="@+id/tvError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#E53935"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp"/>

                <!-- BOTÓN INGRESAR -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Ingresar al sistema"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_btn_teal"
                    android:letterSpacing="0.02"
                    android:layout_marginBottom="16dp"/>

                <!-- Separador -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E8E1D9"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="O TAMBIÉN"
                        android:textSize="10sp"
                        android:textColor="#9AA5A4"
                        android:letterSpacing="0.12"
                        android:paddingLeft="12dp"
                        android:paddingRight="12dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E8E1D9"/>
                </LinearLayout>

                <!-- BOTÓN VOLVER -->
                <Button
                    android:id="@+id/btnVolver"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Volver al inicio"
                    android:textSize="13sp"
                    android:textColor="#3F4946"
                    android:background="@drawable/bg_btn_outline"
                    android:layout_marginBottom="4dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- TEXTO INFERIOR -->
        <TextView
            android:id="@+id/tvProblemas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:textSize="12sp"
            android:textColor="#6F7976"/>

        <!-- FOOTER VA:labs -->
        <LinearLayout
            android:id="@+id/footerValabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESARROLLADO POR"
                android:textSize="7sp"
                android:letterSpacing="0.30"
                android:textColor="#9AA5A4"
                android:layout_marginBottom="4dp"/>

            <!-- Logo VA:labs multicolor -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&lt;"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E91E8C"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="V"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#2196F3"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Λ"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#9C27B0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#00BCD4"
                    android:layout_marginLeft="3dp"
                    android:layout_marginRight="3dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="labs"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B17"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/&gt;"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#E91E8C"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOBILE &amp; BACKEND ENGINEERING"
                android:textSize="7sp"
                android:letterSpacing="0.25"
                android:textColor="#00BCD4"
                android:alpha="0.8"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COPYRIGHT 2026"
                android:textSize="7sp"
                android:letterSpacing="0.30"
                android:textColor="#9AA5A4"
                android:alpha="0.5"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>