<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Fondo decorativo círculo superior -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-120dp"
        android:background="@drawable/bg_glow_circle"
        android:alpha="0.18"/>

    <!-- Fondo decorativo círculo inferior derecho -->
    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_glow_circle_blue"
        android:alpha="0.10"/>

    <!-- CONTENIDO PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── HEADER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp"
                android:paddingTop="48dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    app:cardCornerRadius="19dp"
                    app:cardBackgroundColor="#007A76"
                    app:cardElevation="0dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="W"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:gravity="center"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Domicilios Wil"
                    android:textSize="14sp"
                    android:textColor="#94A3B8"/>
            </LinearLayout>

            <!-- ── HERO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="32dp"
                android:paddingHorizontal="24dp">

                <!-- Icono con anillos de pulso -->
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Anillo exterior -->
                    <View
                        android:id="@+id/ringOuter"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pulse_ring_teal"
                        android:alpha="0.3"/>

                    <!-- Anillo medio -->
                    <View
                        android:id="@+id/ringMid"
                        android:layout_width="82dp"
                        android:layout_height="82dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_pulse_ring_teal"
                        android:alpha="0.5"/>

                    <!-- Núcleo -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        app:cardCornerRadius="32dp"
                        app:cardBackgroundColor="#1E293B"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_map_pin_search"
                            app:tint="#38BDF8"
                            android:contentDescription="Rastrear"/>
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Dónde está tu pedido?"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#F1F5F9"
                    android:layout_marginBottom="10dp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ingresa el código para ver a tu domiciliario en tiempo real"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:paddingHorizontal="20dp"/>
            </LinearLayout>

            <!-- ── CARD PRINCIPAL ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="0dp"
                app:cardBackgroundColor="#1E293B"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Label -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CÓDIGO DE SEGUIMIENTO"
                        android:textSize="10sp"
                        android:textColor="#475569"
                        android:letterSpacing="0.10"
                        android:layout_marginBottom="14dp"/>

                    <!-- Input código -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCodigo"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxStrokeColor="#1E3A5F"
                        app:boxStrokeWidth="1.5dp"
                        app:boxBackgroundColor="#0F172A"
                        app:startIconDrawable="@drawable/ic_hash"
                        app:startIconTint="#38BDF8"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCodigo"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:hint="Ej: WIL-20481"
                            android:textColor="#F1F5F9"
                            android:textColorHint="#2D3F55"
                            android:textSize="18sp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.15"
                            android:inputType="textCapCharacters"
                            android:maxLength="12"
                            android:imeOptions="actionSearch"
                            android:singleLine="true"
                            android:backgroundTint="@android:color/transparent"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Botón rastrear -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRastrear"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:text="Rastrear pedido"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="24dp"
                        app:backgroundTint="#007A76"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_radar"
                        app:iconTint="#FFFFFF"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"/>

                    <!-- Info chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <!-- Chip 1 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_chip_dark"
                            android:padding="12dp"
                            android:layout_marginEnd="4dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_clock"
                                app:tint="#38BDF8"
                                android:layout_marginBottom="6dp"
                                android:contentDescription="Tiempo"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Actualización cada 10 seg"
                                android:textSize="10sp"
                                android:textColor="#475569"
                                android:gravity="center"
                                android:lineSpacingMultiplier="1.3"/>
                        </LinearLayout>

                        <!-- Chip 2 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_chip_dark"
                            android:padding="12dp"
                            android:layout_marginHorizontal="4dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_map"
                                app:tint="#38BDF8"
                                android:layout_marginBottom="6dp"
                                android:contentDescription="Mapa"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mapa en tiempo real"
                                android:textSize="10sp"
                                android:textColor="#475569"
                                android:gravity="center"
                                android:lineSpacingMultiplier="1.3"/>
                        </LinearLayout>

                        <!-- Chip 3 -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_chip_dark"
                            android:padding="12dp"
                            android:layout_marginStart="4dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_shield_check"
                                app:tint="#38BDF8"
                                android:layout_marginBottom="6dp"
                                android:contentDescription="Seguro"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Datos seguros"
                                android:textSize="10sp"
                                android:textColor="#475569"
                                android:gravity="center"
                                android:lineSpacingMultiplier="1.3"/>
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Espaciado inferior para que el FAB no tape nada -->
                    <View android:layout_width="match_parent" android:layout_height="64dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── FAB: ¿Olvidaste tu código? ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOlvidecodigo"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="¿Olvidaste tu código?"
        android:textColor="#93C5FD"
        android:textSize="12sp"
        app:strokeColor="#2563EB"
        app:strokeWidth="1.5dp"
        app:cornerRadius="22dp"
        app:backgroundTint="#1E3A5F"
        app:icon="@drawable/ic_help_circle"
        app:iconTint="#93C5FD"
        app:iconPadding="6dp"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>