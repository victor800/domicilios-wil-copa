<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E293B"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="24dp">

    <!-- Anillos de pulso -->
    <FrameLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp">

        <View
            android:id="@+id/bsRingOuter"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring_teal"
            android:alpha="0.3"/>

        <View
            android:id="@+id/bsRingInner"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring_teal"
            android:alpha="0.5"/>

        <androidx.cardview.widget.CardView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="#0F3D2E"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/bsFoundEmoji"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="22sp"/>
        </androidx.cardview.widget.CardView>

    </FrameLayout>

    <!-- Título -->
    <TextView
        android:id="@+id/bsFoundTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#F1F5F9"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <!-- Subtítulo -->
    <TextView
        android:id="@+id/bsFoundSub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#64748B"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginBottom="16dp"/>

    <!-- Badge ID -->
    <TextView
        android:id="@+id/bsFoundId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_chip_dark"
        android:paddingHorizontal="20dp"
        android:paddingVertical="8dp"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#38BDF8"
        android:fontFamily="monospace"
        android:layout_marginBottom="28dp"/>

    <!-- Botón Ver -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bsFoundBtnVer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Ver mi pedido"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"
        app:backgroundTint="#007A76"
        app:cornerRadius="14dp"/>

    <!-- Botón Cerrar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/bsFoundBtnCerrar"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancelar"
        android:textColor="#64748B"
        app:strokeColor="#2D3F55"
        app:cornerRadius="14dp"
        app:backgroundTint="@android:color/transparent"/>

</LinearLayout>