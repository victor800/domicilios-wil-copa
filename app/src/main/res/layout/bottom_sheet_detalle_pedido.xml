<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="32dp">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="16dp"
        android:background="#D1D5DB"/>

    <!-- Header: ID + estado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/bsIdPedido"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="#WIL-001"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#00897A"/>

        <TextView
            android:id="@+id/bsEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pendiente"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#D97706"
            android:background="@drawable/bg_badge_orange"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>
    </LinearLayout>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0F4F4" android:layout_marginBottom="16dp"/>

    <!-- Sección Cliente -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLIENTE"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="#9AA5A4"
        android:paddingLeft="20dp"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="6dp">

        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_person" android:alpha="0.5"
            android:layout_marginEnd="10dp" android:contentDescription="Cliente"/>
        <TextView android:id="@+id/bsNombre"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#1E1B17"/>
    </LinearLayout>

    <!-- Dirección + botón Maps -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp">

        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_location" android:alpha="0.5"
            android:layout_marginEnd="10dp" android:contentDescription="Dirección"/>

        <TextView android:id="@+id/bsDireccion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="13sp" android:textColor="#3F4946" android:maxLines="3"/>

        <!-- Botón abrir en Maps -->
        <LinearLayout
            android:id="@+id/btnAbrirMaps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_badge_estado"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍"
                android:textSize="18sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Maps"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#2563EB"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Sección Pedido -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0F4F4" android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PEDIDO"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="#9AA5A4"
        android:paddingLeft="20dp"
        android:paddingBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="6dp">

        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_store" android:alpha="0.5"
            android:layout_marginEnd="10dp" android:contentDescription="Comercio"/>
        <TextView android:id="@+id/bsComercio"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp" android:textColor="#3F4946"/>
        <TextView android:id="@+id/bsHora"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:fontFamily="monospace" android:textColor="#9AA5A4"/>
    </LinearLayout>

    <!-- ══ TICKET DE PRODUCTOS ══ -->
    <TextView
        android:id="@+id/bsProductosLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRODUCTOS"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="#9AA5A4"
        android:paddingLeft="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:visibility="gone"/>

    <!-- Ticket container -->
    <LinearLayout
        android:id="@+id/bsTicketContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <!-- Encabezado ticket -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CANT  PRODUCTO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:textColor="#9AA5A4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SUBTOTAL"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:textColor="#9AA5A4"/>
        </LinearLayout>

        <!-- Línea punteada -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- - - - - - - - - - - - - - - - - - - - - - - - - - - -"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:textColor="#D1D5DB"
            android:layout_marginBottom="4dp"/>

        <!-- Filas de productos — se llenan dinámicamente desde el Fragment -->
        <LinearLayout
            android:id="@+id/bsProductosRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <!-- Línea punteada cierre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="- - - - - - - - - - - - - - - - - - - - - - - - - - - -"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:textColor="#D1D5DB"
            android:layout_marginTop="4dp"/>

    </LinearLayout>

    <!-- Campo legacy oculto — mantener para compatibilidad -->
    <TextView
        android:id="@+id/bsProductos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <!-- Totales -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#F0F4F4" android:layout_marginTop="10dp"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="14dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TOTAL PEDIDO" android:textSize="8sp" android:textStyle="bold"
                android:letterSpacing="0.12" android:textColor="#9AA5A4"/>
            <TextView android:id="@+id/bsTotal"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold"
                android:fontFamily="monospace" android:textColor="#00897A"/>
        </LinearLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="DOMICILIO" android:textSize="8sp" android:textStyle="bold"
                android:letterSpacing="0.12" android:textColor="#9AA5A4"/>
            <TextView android:id="@+id/bsDomicilio"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="20sp" android:textStyle="bold"
                android:fontFamily="monospace" android:textColor="#2563EB"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Método de pago -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="💳 " android:textSize="14sp"/>
        <TextView android:id="@+id/bsMetodoPago"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#3F4946"/>
    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <Button
            android:id="@+id/bsBtnLlamar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="📞 Llamar"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#00897A"
            android:background="@drawable/bg_btn_teal_outline"
            android:visibility="gone"/>

        <Button
            android:id="@+id/bsBtnCerrar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cerrar"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_teal"/>
    </LinearLayout>

</LinearLayout>