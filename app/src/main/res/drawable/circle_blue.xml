<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <color android:color="#1E88E5"/> <!-- darker blue -->
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <color android:color="#42A5F5"/> <!-- slightly lighter blue -->
    </item>

    <!-- Selected state -->
    <item android:state_selected="true">
        <color android:color="#64B5F6"/> <!-- even lighter blue -->
    </item>

    <!-- Default state -->
    <item>
        <color android:color="#2196F3"/> <!-- standard blue -->
    </item>
</selector>